---
import { getWaitlistConfig } from '../lib/waitlist-config';
import { SITE, url } from '../lib/site';

const cfg = getWaitlistConfig();
const disabled = cfg.mode === 'none';
if (cfg.misconfigured) {
  console.warn(`[waitlist] PUBLIC_WAITLIST_MODE="${cfg.requestedMode}" is missing required settings; falling back to "none".`);
}
---
<div class="card p-6 sm:p-8" data-waitlist-root>
  {disabled && (
    <div role="status" class="mb-7 rounded-card border border-accent/40 bg-accent-soft p-5" data-waitlist-offline>
      <p class="font-semibold text-fg">Sign-ups open soon</p>
      <p class="mt-1.5 text-sm leading-relaxed text-fg-muted">
        Thanks for your interest! Our barber waitlist isn't connected yet, so this form can't accept sign-ups today and
        nothing you type here will be sent. We're launching with {SITE.city} barbers first. Bookmark this page and check back soon.
      </p>
      {cfg.fallbackEmail && (
        <p class="mt-3 text-sm text-fg-muted">
          Can't wait? Email us at <a class="font-medium text-accent underline underline-offset-2 hover:text-accent-hover" href={`mailto:${cfg.fallbackEmail}?subject=${encodeURIComponent('Fade barber waitlist')}`}>{cfg.fallbackEmail}</a>
          with your name, city and Instagram handle.
        </p>
      )}
    </div>
  )}

  <form
    novalidate
    data-waitlist-form
    data-mode={cfg.mode}
    data-endpoint={cfg.endpoint}
    data-key={cfg.anonKey}
    aria-describedby="waitlist-privacy"
  >
    <fieldset disabled={disabled} class="m-0 min-w-0 border-0 p-0 disabled:opacity-70">
      <legend class="sr-only">Barber waitlist sign-up</legend>

      <div class="grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class="field-label" for="wl-name">Full name <span class="text-danger" aria-hidden="true">*</span></label>
          <input class="field-input" id="wl-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="wl-name-err" />
          <p id="wl-name-err" class="mt-1.5 hidden text-sm text-danger" data-error-for="name"></p>
        </div>

        <div class="sm:col-span-2">
          <label class="field-label" for="wl-email">Email <span class="text-danger" aria-hidden="true">*</span></label>
          <input class="field-input" id="wl-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" aria-describedby="wl-email-err" />
          <p id="wl-email-err" class="mt-1.5 hidden text-sm text-danger" data-error-for="email"></p>
        </div>
        <div class="sm:col-span-2">
          <span class="field-label" id="wl-role-label">I am a <span class="text-danger" aria-hidden="true">*</span></span>
          <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-labelledby="wl-role-label" aria-describedby="wl-role-err">
            <label class="flex cursor-pointer items-center gap-2 rounded-control border border-border-strong bg-surface-raised px-3 py-2.5 text-sm has-[:checked]:border-accent has-[:checked]:bg-accent-soft has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-accent">
              <input type="radio" name="role" value="barber" class="accent-[var(--color-accent)]" checked required />
              Barber
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-control border border-border-strong bg-surface-raised px-3 py-2.5 text-sm has-[:checked]:border-accent has-[:checked]:bg-accent-soft has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-accent">
              <input type="radio" name="role" value="shop_owner" class="accent-[var(--color-accent)]" />
              Shop owner
            </label>
          </div>
          <p id="wl-role-err" class="mt-1.5 hidden text-sm text-danger" data-error-for="role"></p>
        </div>
        <div>
          <label class="field-label" for="wl-city">City <span class="text-danger" aria-hidden="true">*</span></label>
          <input class="field-input" id="wl-city" name="city" type="text" autocomplete="address-level2" required maxlength="120" value={SITE.city} aria-describedby="wl-city-err" />
          <p id="wl-city-err" class="mt-1.5 hidden text-sm text-danger" data-error-for="city"></p>
        </div>
        <div>
          <label class="field-label" for="wl-ig">Instagram <span class="font-normal text-fg-subtle">(optional)</span></label>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-fg-subtle" aria-hidden="true">@</span>
            <input class="field-input pl-8" id="wl-ig" name="instagram" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="60" placeholder="yourhandle" aria-describedby="wl-ig-err" />
          </div>
          <p id="wl-ig-err" class="mt-1.5 hidden text-sm text-danger" data-error-for="instagram"></p>
        </div>
        <div class="sm:col-span-2">
          <label class="field-label" for="wl-shop">Shop name <span class="font-normal text-fg-subtle">(optional)</span></label>
          <input class="field-input" id="wl-shop" name="shop_name" type="text" autocomplete="organization" maxlength="160" />
        </div>





        <!-- Honeypot: hidden from people and assistive tech; bots tend to fill it. -->
        <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label for="wl-website">Website</label>
          <input id="wl-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="sm:col-span-2">
          <label class="flex cursor-pointer items-start gap-3 text-sm text-fg-muted">
            <input id="wl-consent" name="consent" type="checkbox" required class="mt-0.5 h-4 w-4 shrink-0 accent-[var(--color-accent)]" aria-describedby="wl-consent-err" />
            <span>
              I agree that Fade can email me about early access and launch updates. I can unsubscribe at any time.
              See the <a class="text-accent underline underline-offset-2 hover:text-accent-hover" href={url('/privacy/')}>privacy policy (draft)</a>.
            </span>
          </label>
          <p id="wl-consent-err" class="mt-1.5 hidden text-sm text-danger" data-error-for="consent"></p>
        </div>
      </div>

      <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
        <button type="submit" class="btn btn-primary shrink-0 px-6 py-3.5 text-base" data-submit>
          {disabled ? 'Sign-ups open soon' : 'Join the waitlist'}
        </button>
        <p id="waitlist-privacy" class="text-xs text-fg-subtle">We only use this to contact you about Fade. We never sell your info.</p>
      </div>
    </fieldset>

    <div class="mt-6 hidden rounded-card border p-4 text-sm" role="alert" aria-live="assertive" data-status></div>
  </form>

  <div class="hidden text-center" data-success tabindex="-1">
    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-success-soft text-success" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17l9-10" /></svg>
    </div>
    <h2 class="mt-4 font-display text-2xl font-semibold text-fg">You're on the list</h2>
    <p class="mx-auto mt-2 max-w-md text-fg-muted" data-success-msg>Thanks! We'll email you when early access opens for barbers in your city.</p>
    <a href={url('/')} class="btn btn-secondary mt-6">Back to home</a>
  </div>
</div>

<script>
  type Fields = Record<string, string | boolean>;

  const root = document.querySelector<HTMLElement>('[data-waitlist-root]');
  const form = root?.querySelector<HTMLFormElement>('[data-waitlist-form]');

  if (root && form) {
    const mode = form.dataset.mode || 'none';
    const endpoint = form.dataset.endpoint || '';
    const key = form.dataset.key || '';
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const successMsg = root.querySelector<HTMLElement>('[data-success-msg]')!;
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    const IG_RE = /^[A-Za-z0-9._]{1,30}$/;

    const setError = (name: string, msg: string) => {
      const el = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const inputs = form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`);
      inputs.forEach((i) => (msg ? i.setAttribute('aria-invalid', 'true') : i.removeAttribute('aria-invalid')));
      if (el) { el.textContent = msg; el.classList.toggle('hidden', !msg); }
    };

    const showStatus = (kind: 'error' | 'info', msg: string) => {
      status.textContent = msg;
      status.className = 'mt-6 rounded-card border p-4 text-sm ' +
        (kind === 'error' ? 'border-danger/40 bg-danger-soft text-fg' : 'border-border bg-surface-raised text-fg-muted');
    };
    const clearStatus = () => { status.className = 'mt-6 hidden'; status.textContent = ''; };

    const read = (): Fields => {
      const fd = new FormData(form);
      const ig = String(fd.get('instagram') || '').trim().replace(/^@+/, '').replace(/^https?:\/\/(www\.)?instagram\.com\//i, '').replace(/\/.*$/, '');
      return {
        name: String(fd.get('name') || '').trim(),
        email: String(fd.get('email') || '').trim().toLowerCase(),
        city: String(fd.get('city') || '').trim(),
        role: String(fd.get('role') || ''),
        shop_name: String(fd.get('shop_name') || '').trim(),
        instagram: ig,
        consent: fd.get('consent') === 'on',
        website: String(fd.get('website') || ''),
      };
    };

    const validate = (f: Fields): boolean => {
      const errs: Record<string, string> = {};
      if (!f.name) errs.name = 'Please enter your name.';
      if (!f.email) errs.email = 'Please enter your email.';
      else if (!EMAIL_RE.test(String(f.email))) errs.email = 'That email doesn\u2019t look right. Check for typos.';
      if (!f.city) errs.city = 'Please enter your city.';
      if (f.role !== 'barber' && f.role !== 'shop_owner') errs.role = 'Choose barber or shop owner.';
      if (f.instagram && !IG_RE.test(String(f.instagram))) errs.instagram = 'Use letters, numbers, periods or underscores (no spaces).';
      if (!f.consent) errs.consent = 'Please agree so we can email you about early access.';
      ['name', 'email', 'city', 'role', 'instagram', 'consent'].forEach((n) => setError(n, errs[n] || ''));
      const first = Object.keys(errs)[0];
      if (first) form.querySelector<HTMLInputElement>(`[name="${first}"]`)?.focus();
      return !first;
    };

    const done = (msg?: string) => {
      if (msg) successMsg.textContent = msg;
      form.classList.add('hidden');
      root.querySelector('[data-waitlist-offline]')?.classList.add('hidden');
      success.classList.remove('hidden');
      success.focus();
    };

    // Re-validate a field once the user has interacted with it.
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t?.getAttribute('aria-invalid') === 'true') validate(read());
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearStatus();
      if (mode === 'none') {
        showStatus('info', 'Sign-ups aren\u2019t open yet, so nothing was sent. Please check back soon.');
        return;
      }
      const f = read();
      if (!validate(f)) return;

      // Honeypot tripped: pretend success, send nothing.
      if (f.website) { done(); return; }

      const payload = {
        name: f.name, email: f.email, city: f.city, role: f.role,
        shop_name: f.shop_name || null, instagram: f.instagram || null,
        consent: true, source: 'landing',
      };

      submit.disabled = true;
      const label = submit.textContent;
      submit.textContent = 'Sending\u2026';
      try {
        let res: Response;
        if (mode === 'supabase') {
          const headers: Record<string, string> = {
            'Content-Type': 'application/json',
            apikey: key,
            Prefer: 'return=minimal',
          };
          // Legacy anon keys are JWTs and go in Authorization too; new sb_publishable_ keys must not.
          if (key.startsWith('eyJ')) headers.Authorization = `Bearer ${key}`;
          res = await fetch(endpoint, {
            method: 'POST',
            headers,
            body: JSON.stringify(payload),
          });
          if (res.status === 409) { done('You\u2019re already on the list. We\u2019ll be in touch when early access opens.'); return; }
        } else {
          res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          });
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        window.fadeTrack?.('waitlist_signup', { role: String(f.role) });
        done();
      } catch (err) {
        console.error('[waitlist] submit failed', err);
        showStatus('error', 'Something went wrong and your sign-up wasn\u2019t saved. Please check your connection and try again in a moment.');
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  }
</script>
