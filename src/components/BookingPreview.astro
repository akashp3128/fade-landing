---
/**
 * Illustrative mock of a barber's public booking page. All data is placeholder,
 * not a real barber, and labelled as such.
 */
const services = [
  { name: 'Haircut', time: '45 min', price: '$—' },
  { name: 'Skin fade', time: '45 min', price: '$—' },
  { name: 'Beard trim', time: '20 min', price: '$—' },
];
const slots = ['10:00', '10:45', '11:30', '1:15', '2:00', '3:30'];
---
<figure class="relative mx-auto w-full max-w-sm">
  <div class="absolute -inset-6 -z-10 rounded-[2rem] bg-[radial-gradient(closest-side,var(--color-accent-soft),transparent)]" aria-hidden="true"></div>
  <div class="overflow-hidden rounded-panel border border-border-strong bg-surface shadow-2xl shadow-black/50">
    <div class="flex items-center gap-2 border-b border-border bg-surface-raised px-4 py-2.5">
      <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
      <span class="ml-2 truncate rounded-md bg-canvas px-2 py-0.5 font-mono text-[0.7rem] text-fg-subtle">fade link · /your-name</span>
    </div>
    <div class="p-5">
      <div class="flex items-center gap-3">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-accent-soft font-display text-lg font-semibold text-accent" aria-hidden="true">YN</div>
        <div>
          <p class="font-semibold text-fg">Your Name</p>
          <p class="text-xs text-fg-muted">Your Shop · Chicago, IL</p>
        </div>
      </div>

      <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-fg-subtle">Services</p>
      <ul class="mt-2 divide-y divide-border rounded-card border border-border">
        {services.map((s, i) => (
          <li class:list={['flex items-center justify-between px-3 py-2.5 text-sm', i === 1 && 'bg-accent-soft']}>
            <span>
              <span class="font-medium text-fg">{s.name}</span>
              <span class="ml-2 text-xs text-fg-subtle">{s.time}</span>
            </span>
            <span class="font-medium text-fg-muted">{s.price}</span>
          </li>
        ))}
      </ul>

      <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-fg-subtle">Open times · Thu</p>
      <div class="mt-2 grid grid-cols-3 gap-2">
        {slots.map((t, i) => (
          <span class:list={[
            'rounded-control border px-2 py-1.5 text-center text-xs font-medium',
            i === 2 ? 'border-accent bg-accent text-accent-fg' : 'border-border text-fg-muted',
          ]}>{t}</span>
        ))}
      </div>

      <div class="mt-5 flex items-center justify-between rounded-control bg-accent px-4 py-3 text-sm font-semibold text-accent-fg">
        <span>Book &amp; pay</span>
        <span aria-hidden="true">→</span>
      </div>
    </div>
  </div>
  <figcaption class="mt-3 text-center text-xs text-fg-subtle">Illustrative preview with placeholder details, not a real barber.</figcaption>
</figure>
