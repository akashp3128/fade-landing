---
import BaseLayout from '../layouts/BaseLayout.astro';
import DraftBanner from '../components/DraftBanner.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/site';

// PLACEHOLDER tiers. Nothing here is a real price or commitment. Replace once pricing is decided.
const tiers = [
  {
    name: 'Starter',
    price: '$[TBD]',
    period: '',
    blurb: 'Placeholder tier for barbers getting started.',
    features: ['Barber profile and booking link', 'Services, prices and weekly hours', 'Bookings and schedule', 'Stripe Connect payouts'],
    highlight: false,
  },
  {
    name: 'Pro',
    price: '$[TBD]',
    period: '/ month',
    blurb: 'Placeholder tier for full-time barbers.',
    features: ['Everything in Starter', 'Placeholder: additional booking controls', 'Placeholder: reminders and rebooking', 'Placeholder: priority support'],
    highlight: true,
  },
  {
    name: 'Shop',
    price: 'Later',
    period: '',
    blurb: 'Team and shop management is planned after the first release.',
    features: ['Multiple barbers under one shop', 'Shared shop page', 'Not part of v1'],
    highlight: false,
  },
];
---
<BaseLayout
  title="Pricing"
  description="Fade pricing for barbers is not final. These placeholder tiers show the direction; real prices will be confirmed before anyone is charged."
>
  <section class="container-page pb-6 pt-14 md:pt-20">
    <p class="eyebrow">Pricing</p>
    <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">Simple pricing for barbers</h1>
    <p class="mt-5 max-w-2xl text-lg text-fg-muted">We are still setting prices with input from early barbers. Nobody is charged during the waitlist.</p>
    <div class="mt-8 max-w-3xl">
      <DraftBanner label="PLACEHOLDER PRICING — not final">
        The tiers, prices and features below are placeholders for layout and discussion only. They are not an offer.
        Final pricing, including how Stripe processing fees are handled, will be published before launch.
      </DraftBanner>
    </div>
  </section>

  <section class="container-page py-10" aria-label="Placeholder pricing tiers">
    <ul class="grid gap-5 lg:grid-cols-3">
      {tiers.map((t) => (
        <li class:list={[
          'relative flex flex-col rounded-panel border p-7',
          t.highlight ? 'border-accent/60 bg-surface shadow-[0_0_0_1px_var(--color-accent-soft)]' : 'border-border bg-surface/60',
        ]}>
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-fg">{t.name}</h2>
            <span class="placeholder-tag">Placeholder</span>
          </div>
          <p class="mt-5 flex items-baseline gap-1.5">
            <span class="font-display text-4xl font-semibold text-fg">{t.price}</span>
            {t.period && <span class="text-sm text-fg-subtle">{t.period}</span>}
          </p>
          <p class="mt-3 text-sm text-fg-muted">{t.blurb}</p>
          <ul class="mt-6 flex-1 space-y-3 border-t border-border pt-6 text-sm">
            {t.features.map((f) => (
              <li class="flex gap-2.5 text-fg-muted"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />{f}</li>
            ))}
          </ul>
          <a href={url('/waitlist/')} class:list={['mt-8', t.highlight ? 'btn btn-primary' : 'btn btn-secondary']}>
            Join the waitlist
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page py-10" aria-labelledby="pricing-faq">
    <h2 id="pricing-faq" class="font-display text-2xl font-semibold tracking-tight">Pricing questions</h2>
    <dl class="mt-6 grid gap-6 md:grid-cols-2">
      <div class="card p-6">
        <dt class="font-semibold text-fg">Do I pay to join the waitlist?</dt>
        <dd class="mt-2 text-sm text-fg-muted">No. Joining the waitlist is free and does not require a card.</dd>
      </div>
      <div class="card p-6">
        <dt class="font-semibold text-fg">What about card processing fees?</dt>
        <dd class="mt-2 text-sm text-fg-muted">Payments run through Stripe, which charges processing fees. How those are handled is part of the pricing we have not finalized yet.</dd>
      </div>
      <div class="card p-6">
        <dt class="font-semibold text-fg">Will early barbers get a deal?</dt>
        <dd class="mt-2 text-sm text-fg-muted">We have not decided yet. If we offer early-access terms, waitlist members will hear about them first.</dd>
      </div>
      <div class="card p-6">
        <dt class="font-semibold text-fg">Can my whole shop join?</dt>
        <dd class="mt-2 text-sm text-fg-muted">Individual barbers come first. Shop and team features are planned for after the first release. Shop owners can still join the waitlist.</dd>
      </div>
    </dl>
  </section>
</BaseLayout>
