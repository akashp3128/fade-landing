# Copy to .env for local dev. Every value here is PUBLIC: it is baked into the static
# HTML/JS at build time, so never put a secret (service_role key, API secret) in a PUBLIC_ var.
# In GitHub Actions, set these as repository *Variables* (Settings → Secrets and variables → Actions → Variables).

# ---------------------------------------------------------------------------
# Waitlist form
# ---------------------------------------------------------------------------
# none      → default. Form is shown but disabled with a friendly "sign-ups open soon" notice.
# supabase  → POST to Supabase REST: {PUBLIC_SUPABASE_URL}/rest/v1/{PUBLIC_SUPABASE_WAITLIST_TABLE}
# formspree → POST JSON to PUBLIC_WAITLIST_ENDPOINT (e.g. https://formspree.io/f/xxxxxxx)
# endpoint  → POST JSON to any form endpoint at PUBLIC_WAITLIST_ENDPOINT (Basin, Getform, your own API...)
PUBLIC_WAITLIST_MODE=none

# supabase mode (run supabase/waitlist.sql in the project first). Use the project's *publishable*
# key (sb_publishable_...). It is designed to be public; RLS on barber_waitlist only allows INSERT,
# never SELECT. A legacy anon JWT (eyJ...) in PUBLIC_SUPABASE_ANON_KEY also works.
# NEVER use the secret / service_role key here.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_SUPABASE_WAITLIST_TABLE=barber_waitlist

# formspree / endpoint mode
PUBLIC_WAITLIST_ENDPOINT=

# Optional. If set, the "not connected yet" notice offers a mailto link to this address.
# Leave empty until there is a real, monitored inbox.
PUBLIC_WAITLIST_FALLBACK_EMAIL=

# ---------------------------------------------------------------------------
# Analytics (off unless a provider is set)
# ---------------------------------------------------------------------------
# none | plausible | umami
PUBLIC_ANALYTICS_PROVIDER=none
# plausible
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# umami
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=

# ---------------------------------------------------------------------------
# Deploy target (optional; defaults to the GitHub Pages project URL)
# ---------------------------------------------------------------------------
# SITE_URL=https://akashp3128.github.io
# BASE_PATH=/fade-landing
